# Keep local development private by default. Public deployments must explicitly
# enable public mode and use a long secret.
PALETTE_PUBLIC=0
PALETTE_HOST=127.0.0.1
PALETTE_PORT=8765
PALETTE_USERNAME=palette
PALETTE_PASSWORD=replace-with-at-least-16-random-characters

# Runtime state. Source runs default to this directory; `nix run path:.` also
# uses it when launched from the checkout so existing history stays visible.
# PALETTE_DATA_DIR=/home/erop/Documents/personalstuff/palletegen
# PALETTE_HISTORY_DIR=/home/erop/Documents/personalstuff/palletegen/palette-history

# A normal Nix install is used automatically. Override only when needed.
# PALETTE_NIX=/run/current-system/sw/bin/nix
#
# For nix-portable deployments, put the runtime somewhere permanent and owned by
# the service account. When this is set it takes precedence over PALETTE_NIX.
# PALETTE_NIX_PORTABLE=/opt/palette-generator/nix-portable

# Resource and retention boundaries.
PALETTE_MAX_IMAGE_MB=25
PALETTE_MAX_IMAGE_PIXELS=50000000
# 0 keeps unlimited history. Positive values enable automatic retention limits.
PALETTE_MAX_HISTORY=0
PALETTE_MAX_HISTORY_MB=0
# 0 disables generation rate limiting. Set this to a positive number for public use.
PALETTE_RATE_LIMIT=0
