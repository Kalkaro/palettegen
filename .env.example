# Public deployments must explicitly enable public mode and use a long secret.
PALETTE_PUBLIC=1
PALETTE_HOST=127.0.0.1
PALETTE_PORT=8765
PALETTE_USERNAME=palette
PALETTE_PASSWORD=replace-with-at-least-16-random-characters

# Put the runtime somewhere permanent and owned by the service account.
PALETTE_NIX_PORTABLE=/opt/palette-generator/nix-portable

# Resource and retention boundaries.
PALETTE_MAX_IMAGE_MB=25
PALETTE_MAX_IMAGE_PIXELS=50000000
# 0 keeps unlimited history. Positive values enable automatic retention limits.
PALETTE_MAX_HISTORY=0
PALETTE_MAX_HISTORY_MB=0
# 0 disables generation rate limiting. Set this to a positive number for public use.
PALETTE_RATE_LIMIT=0
